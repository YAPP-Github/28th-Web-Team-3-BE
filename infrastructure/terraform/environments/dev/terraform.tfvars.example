project_id          = "<dev-project-id>"
region              = "<gcp-region>"
state_bucket_name   = "dev-<globally-unique-state-bucket>"
jwt_issuer          = "<dev-jwt-issuer>"
jwt_audience        = "<dev-jwt-audience>"
server_url          = ""
bootstrap_image_uri = null

# Set true only after required GitHub Environment Secrets have been synced.
enable_runtime_services = false
scheduler_paused        = true
enable_ai              = false
enable_policy_import   = false
